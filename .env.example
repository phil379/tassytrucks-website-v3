# ─────────────────────────────────────────────────────────────────────────────
# tassytrucks-website — environment
#
# Copy to .env.local for development. NEVER commit real values.
# Every variable here is server-side only: none is prefixed NEXT_PUBLIC_, so
# Next.js will not inline any of them into the browser bundle.
#
# Add all of these to Vercel (Production + Preview) before /request goes live.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase: the tassy-ops project ──────────────────────────────────────────
# Project ref: knllznbdpejoaiexmdea (us-east-1). This is a NEW, standalone
# project. It is NOT the SaaS project — do not point these at that one.
# Dashboard → Project Settings → API.
SUPABASE_URL=

# Service-role key. Bypasses RLS; used only in server routes and server actions.
# If this ever reaches the browser, rotate it immediately.
# Dashboard → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# ── Notification 1: operator SMS, via Zapier ─────────────────────────────────
# A Zapier "Catch Hook" URL. Zapier owns the SMS leg; this app only POSTs JSON.
# Payload shape is documented in lib/notifications.ts (notifyOperatorSms).
ZAPIER_SMS_WEBHOOK_URL=

# ── Notification 2 + 3: email, via Resend ────────────────────────────────────
# Resend API key (https://resend.com → API Keys).
RESEND_API_KEY=

# Where the full-detail "NEW REQUEST" email goes — the operator's inbox.
OPERATOR_EMAIL=

# Verified Resend sender. Optional: defaults to
# "Tassy Transportation <dispatch@tassytrucks.com>" if unset, which will fail
# to send until that domain is verified in Resend.
RESEND_FROM_EMAIL=

# ── /ops queue ───────────────────────────────────────────────────────────────
# Single shared password for the ops queue. Compared server-side; the cookie
# stores an HMAC, never this value. Not real auth — it keeps the queue off the
# open internet and nothing more. Use something long.
OPS_PASSWORD=
