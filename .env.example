# ─────────────────────────────────────────────────────────────────────────────
# tassytrucks-website — environment
#
# Copy to .env.local for development. NEVER commit real values.
# Every variable here is server-side only: none is prefixed NEXT_PUBLIC_, so
# Next.js will not inline any of them into the browser bundle.
#
# Add all of these to Vercel (Production + Preview) before /request goes live.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase: the tassy-ops project ──────────────────────────────────────────
# Project ref: knllznbdpejoaiexmdea (us-east-1). This is a NEW, standalone
# project. It is NOT the SaaS project — do not point these at that one.
# Dashboard → Project Settings → API.
SUPABASE_URL=

# Service-role key. Bypasses RLS; used only in server routes and server actions.
# If this ever reaches the browser, rotate it immediately.
# Dashboard → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# ── Notification 1: push, via ntfy.sh ────────────────────────────────────────
# Free, no account, no quota — replaces the Zapier SMS leg, which burned one of
# 100 free tasks/month per booking AND per escalation.
#
# The topic string IS the credential: anyone who knows it can subscribe. That is
# why the push payload carries only a reference and a pickup time — no name, no
# phone, no address. See the PII RULE comment in lib/notifications.ts.
#
# Subscribe on a phone: install the ntfy app, add this topic.
NTFY_TOPIC=

# Where the push notification's tap-through points. Set to the production origin
# so "Click" opens the live ops queue, not localhost.
NEXT_PUBLIC_SITE_URL=

# ── Optional second sink (not required) ──────────────────────────────────────
# A Zapier "Catch Hook" URL, kept for later use. ABSENT-SAFE: leave this unset
# and the leg silently no-ops — it is reported as "skipped", not "failed", and
# nothing else changes. It receives the same PII-free payload as ntfy.
ZAPIER_SMS_WEBHOOK_URL=

# ── Notification 2 + 3: email, via Resend ────────────────────────────────────
# Resend API key (https://resend.com → API Keys).
RESEND_API_KEY=

# Where the full-detail "NEW REQUEST" email goes — the operator's inbox.
OPERATOR_EMAIL=

# Verified Resend sender. Optional: defaults to
# "Tassy Transportation <dispatch@tassytrucks.com>" if unset, which will fail
# to send until that domain is verified in Resend.
RESEND_FROM_EMAIL=

# ── Speed-to-lead escalation cron ────────────────────────────────────────────
# Vercel sends `Authorization: Bearer $CRON_SECRET` to scheduled routes when
# this is set. /api/cron/escalate-stale-requests REFUSES TO RUN without it,
# rather than leaving an open SMS trigger on the internet. Generate a long
# random string.
#
# Schedule lives in vercel.json: every 15 minutes. A request still in status
# 'new' 90 minutes after created_at gets ONE extra URGENT SMS to the operator —
# never a second message to the customer.
#
# ⚠️ Sub-daily crons require a Vercel PRO plan. On Hobby, vercel.json's
#    "*/15 * * * *" is rejected and only once-daily schedules are allowed.
CRON_SECRET=

# ── /ops queue ───────────────────────────────────────────────────────────────
# Single shared password for the ops queue. Compared server-side; the cookie
# stores an HMAC, never this value. Not real auth — it keeps the queue off the
# open internet and nothing more. Use something long.
OPS_PASSWORD=
